---
/**
 * Footer on navy: tagline, section links, contact, "A program by Tango MJ",
 * legal details of Het Waterwerk Rimburg V.O.F. and the privacy link.
 */
import { CONTACT, LANGUAGE_DETAILS, SECTION_IDS, UI_TEXT, type Language } from '../i18n/languages';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const texts = UI_TEXT[language];
const home = LANGUAGE_DETAILS[language].home;
const year = new Date().getFullYear();

const links = [
  { id: SECTION_IDS.programs, label: texts.navigation.programs },
  { id: SECTION_IDS.method, label: texts.navigation.method },
  { id: SECTION_IDS.about, label: texts.navigation.about },
  { id: SECTION_IDS.faq, label: texts.navigation.faq },
];
---

<footer class="border-t border-crema/15 bg-principal text-crema">
  <div class="container-site grid gap-12 py-16 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1fr)] md:py-20">
    <div class="max-w-[42ch]">
      <p class="text-[1.125rem] font-semibold text-white">{texts.brand.name}</p>
      <p class="mt-3 text-small text-crema/80">{texts.footer.tagline}</p>
      <p class="mt-6 text-small text-crema/80">
        {texts.footer.programBy}{' '}
        <a href={CONTACT.tangoMjUrl} class="font-semibold text-white underline decoration-crema/40 underline-offset-4 hover:decoration-detalle">Tango MJ</a>
      </p>
    </div>

    <nav aria-label={texts.footer.explore}>
      <p class="text-small font-semibold text-white">{texts.footer.explore}</p>
      <ul class="mt-4 grid gap-1">
        {
          links.map((link) => (
            <li>
              <a href={`${home}#${link.id}`} class="inline-block py-1.5 text-small text-crema/80 hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="text-small font-semibold text-white">{texts.footer.contact}</p>
      <ul class="mt-4 grid gap-1 text-small">
        <li>
          <span class="sr-only">{texts.footer.email}: </span>
          <a href={`mailto:${CONTACT.email}`} class="inline-block py-1.5 text-crema/80 hover:text-white">{CONTACT.email}</a>
        </li>
        <li>
          <span class="sr-only">{texts.footer.phone}: </span>
          <a href={CONTACT.phone.href} class="inline-block py-1.5 tabular-nums text-crema/80 hover:text-white">{CONTACT.phone.display}</a>
        </li>
        <li>
          <a href={CONTACT.linkedinUrl} class="inline-block py-1.5 text-crema/80 hover:text-white" target="_blank" rel="noopener noreferrer">
            {texts.footer.linkedin}<span class="sr-only"> {texts.footer.newTab}</span>
          </a>
        </li>
        <li class="pt-1.5 text-crema/80">
          <address class="not-italic">{CONTACT.address.street}<br />{CONTACT.address.postalCode} {CONTACT.address.locality}</address>
        </li>
        <li>
          <a href={`${home}#${SECTION_IDS.contact}`} class="inline-block py-1.5 text-crema/80 hover:text-white">{texts.navigation.cta}</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-crema/15">
    <div class="container-site flex flex-col gap-3 py-6 text-[0.8125rem] text-crema/70 md:flex-row md:items-center md:justify-between">
      <p>© {year} {texts.brand.name}. {texts.footer.rights} {texts.footer.legal}</p>
      <p class="flex flex-wrap gap-x-5 gap-y-1">
        <a href={CONTACT.privacyUrl[language]} class="hover:text-white">{texts.footer.privacy}</a>
        <span>{texts.footer.madeBy} <a href="https://www.waterwerk-websolutions.nl" class="hover:text-white" target="_blank" rel="noopener">Waterwerk Websolutions</a></span>
      </p>
    </div>
  </div>
</footer>

---
/**
 * Hero: the claim, the two actions and the photo of a real workshop, then an
 * index of the three program levels (name, duration, purpose) that leads to #programs.
 * Copy: content/<language>.json → hero and programs.items. No eyebrow above the title.
 */
import { Image } from 'astro:assets';
import workshopPhoto from '../assets/images/taller-grupo.jpg';
import { LANGUAGE_DETAILS, SECTION_IDS, UI_TEXT, type Language } from '../i18n/languages';
import { getContent, levelId } from '../i18n/content';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const content = getContent(language);
const hero = content.hero;
const home = LANGUAGE_DETAILS[language].home;
const ui = UI_TEXT[language];

// "Fun: Experiential Team Building" → "Experiential Team Building" (the level name already says Fun / Team / Leaders).
const levels = content.programs.items.map((program) => ({
  id: levelId(program),
  name: program.nombre,
  short: program.nivelCorto,
  duration: program.duracion,
  purpose: program.nivel.split(':').slice(1).join(':').trim() || program.nivel,
}));
---

<section class="border-b border-line">
  <div class="container-site grid gap-12 pt-12 pb-16 md:pt-16 lg:grid-cols-[minmax(0,1.08fr)_minmax(0,0.92fr)] lg:items-center lg:gap-16 lg:pt-20 lg:pb-20">
    <div class="min-w-0">
      <h1 class="max-w-[14ch] text-display" data-reveal>{hero.titulo}</h1>
      <p class="mt-6 max-w-[52ch] text-lead text-texto-muted" data-reveal>{hero.subtitulo}</p>

      <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal>
        <a
          href={`${home}#${SECTION_IDS.contact}`}
          class="group inline-flex min-h-12 items-center gap-2.5 rounded-full bg-detalle px-6 text-label font-semibold text-texto transition-[color,background-color,border-color,transform] duration-200 hover:bg-[color-mix(in_srgb,var(--color-detalle)_88%,#000)] active:scale-[0.98]"
        >
          {hero.ctaPrincipal}
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">
            <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a
          href={`${home}#${SECTION_IDS.programs}`}
          class="inline-flex min-h-12 items-center rounded-full border-[1.5px] border-line-strong px-6 text-label font-semibold text-principal transition-[color,background-color,border-color,transform] duration-200 hover:border-principal active:scale-[0.98]"
        >
          {hero.ctaSecundario}
        </a>
      </div>
    </div>

    <figure class="min-w-0">
      <Image
        src={workshopPhoto}
        alt={ui.meta.shareImageAlt}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 1200px) 520px, (min-width: 1024px) 44vw, 92vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[3/2] w-full rounded-[var(--radius-image)] object-cover object-[50%_45%] lg:aspect-[4/5]"
      />
    </figure>
  </div>

  <!-- Index of the three levels: a quiet table of contents for the offer, not cards. -->
  <div class="container-site pb-14 lg:pb-16" data-reveal>
    <p class="text-small font-medium text-texto-muted">{hero.nivelesLabel}</p>
    <ul class="mt-4 grid border-t border-line md:grid-cols-3">
      {
        levels.map((level, index) => (
          <li class:list={['min-w-0 border-b border-line md:border-b-0', index > 0 && 'md:border-l md:pl-8', index < levels.length - 1 && 'md:pr-8']}>
            <a href={`${home}#${SECTION_IDS.programs}`} data-select-level={level.id} class="group flex h-full items-start justify-between gap-4 py-6">
              <span class="min-w-0">
                <span class="flex flex-wrap items-baseline gap-x-3 text-small tabular-nums">
                  <span class="font-semibold text-secundario-ink" translate="no">{level.short}</span>
                  <span class="text-texto-muted">{level.duration}</span>
                </span>
                <span class="mt-2 block text-h3 text-principal" translate="no">{level.name}</span>
                <span class="mt-1 block text-small text-texto-muted">{level.purpose}</span>
              </span>
              <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" class="mt-8 shrink-0 text-secundario transition-transform duration-200 group-hover:translate-x-1">
                <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
